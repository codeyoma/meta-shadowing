{
  "name": "meta-shadowing-native",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "start": "expo start",
    "ios": "expo run:ios",
    "test": "tsx --test src/core/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run test && npm run typecheck",
    "bundle:ios": "expo export --platform ios",
    "prepare:audio": "node scripts/prepare-test-audio.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@react-native-community/slider": "5.2.0",
    "expo": "~57.0.21",
    "expo-asset": "~57.0.3",
    "expo-audio": "~57.0.4",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-glass-effect": "~57.0.2",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.4",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.20",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.2",
    "patch-package": "^8.0.1",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  }
}
