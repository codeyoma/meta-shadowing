{
  "name": "meta-shadowing",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:ui": "node scripts/check-ui-primitives.mjs",
    "verify:env": "node --env-file-if-exists=.env.local scripts/check-release-env.mjs",
    "import:kaikki": "node --env-file-if-exists=.env.local scripts/import-kaikki.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:integration": "node scripts/run-admin-persistence-integration.mjs",
    "test:learner-preferences": "node scripts/run-admin-persistence-integration.mjs --learner-preferences",
    "test:db": "npx --yes supabase@2.116.0 test db --local"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@fontsource-variable/noto-sans-kr": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/quicksand": "^5.3.0",
    "@supabase/ssr": "0.12.6",
    "@supabase/supabase-js": "2.115.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "google-auth-library": "11.0.2",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "wink-lemmatizer": "3.0.4"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "24.10.13",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "jsdom": "26.1.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
