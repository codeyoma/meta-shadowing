# Server-only values. Do not prefix either variable with NEXT_PUBLIC_.
BETA_PASSWORD=replace-with-a-long-private-beta-password
LEARNER_COOKIE_SECRET=replace-with-a-random-32-byte-or-longer-secret

# Safe to expose: use the Supabase publishable key, never a secret or service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only. Reads published lessons and creates 60-second private audio URLs.
# Never expose this value through NEXT_PUBLIC_* or browser code.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Server-only. Enable Cloud Natural Language API and restrict this key to it.
GOOGLE_CLOUD_NATURAL_LANGUAGE_API_KEY=

# Alternative: absolute path to a service account JSON key outside this repository.
# Leave the API key above empty to use this file. Never add NEXT_PUBLIC_.
GOOGLE_APPLICATION_CREDENTIALS=
