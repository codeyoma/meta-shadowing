# Non-secret native build configuration. Set the owner-approved value in .env.local.
# Leave empty when no real App Store product has been configured.
APPLE_BOOK_PRODUCT_ID=

# Apple-hosted controlled sample; both values are required for a configured build.
# Register the App Group for BOTH the app and SampleDownloader extension first.
# Keep real identifiers in ignored local configuration, not in public documents.
APPLE_ASSET_APP_GROUP=
APPLE_SAMPLE_ASSET_PACK_ID=
