# Server-only values. Do not prefix either variable with NEXT_PUBLIC_.
BETA_PASSWORD=replace-with-a-long-private-beta-password
LEARNER_COOKIE_SECRET=replace-with-a-random-32-byte-or-longer-secret

# Safe to expose: use the Supabase publishable key, never a secret or service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
