{
  "expo": {
    "name": "쇄도잉",
    "icon": "./assets/brand/app-icon-full-bleed.png",
    "slug": "meta-shadowing-native",
    "scheme": "metashadowing",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios"
    ],
    "ios": {
      "deploymentTarget": "26.0",
      "supportsTablet": false,
      "bundleIdentifier": "com.codeyoma.shadowshadowing",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "./plugins/with-ios-build-settings.js",
      "./plugins/with-local-video-package.js",
      "./modules/package-store/app.plugin.js",
      "./modules/progress-cloud/app.plugin.js",
      "./modules/package-delivery/app.plugin.js",
      "expo-router",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "내 목소리 듣기를 켜면 유선 이어폰으로 실시간 모니터링해요. 다른 앱 사용·화면 잠금 중에도 계속되며, 음성은 저장하거나 전송하지 않아요.",
          "recordAudioAndroid": false,
          "enableBackgroundRecording": true,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/logo.png",
          "imageWidth": 320,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
