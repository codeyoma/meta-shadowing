      "name": "Primary Action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Bee action face with navy ink and a reserved 4-point lip; pointer and keyboard states are documentation-only.",
      "html": "<div class=\"ds-primary-space\"><button class=\"ds-primary\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 12h15m-6-6 6 6-6 6\"/></svg><span>레슨 열기</span></button></div>",
      "css": ".ds-primary-space{padding-bottom:4px}.ds-primary{display:flex;align-items:center;justify-content:center;gap:10px;min-height:54px;width:100%;padding:13px 18px;border:0;border-radius:16px;background:#ffc800;color:#042c60;box-shadow:0 4px 0 #ff9600;font:700 17px/24px system-ui,sans-serif;letter-spacing:.2px;text-align:center}.ds-primary span{min-width:0}.ds-primary svg{flex-shrink:0}.ds-primary:hover{cursor:pointer}.ds-primary:focus-visible{outline:3px solid #042c60;outline-offset:5px}.ds-primary:active{transform:translateY(4px);box-shadow:none}.ds-primary:disabled{background:#e5e5e5;color:#4b4b4b;box-shadow:none;transform:none;cursor:default}"
    },
