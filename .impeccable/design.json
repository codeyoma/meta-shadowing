      "css": ".ds-secondary-space{padding:12px 12px 16px;background:#101c2c}.ds-secondary{display:flex;align-items:center;justify-content:center;min-height:54px;width:100%;padding:13px 18px;border:2px solid #344960;border-radius:16px;background:#192a3e;color:#8dd8ff;box-shadow:0 4px 0 #344960;font:700 17px/24px system-ui,sans-serif;letter-spacing:.2px;text-align:center}.ds-secondary:hover{cursor:pointer}.ds-secondary:focus-visible{outline:3px solid #8dd8ff;outline-offset:5px}.ds-secondary:active{transform:translateY(4px);box-shadow:none}.ds-secondary:disabled{background:#344960;color:#b8c7d8;box-shadow:none;transform:none;cursor:default}"
